def is_valid_ipv4(ip: str) -> bool:
    """Return True if `ip` is a valid IPv4 address (four dot-separated integers 0-255, no leading zeros)."""
    parts = ip.split(".")
    if len(parts) != 4:
        return False
    for part in parts:
        if not part.isdigit() or (len(part) > 1 and part[0] == "0"):
            return False
        if not 0 <= int(part) <= 255:
            return False
    return True


# Example calls
